[Unit]
Description=FileBeans independent video re-encoding queue
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/filebeans-reencode/reencode-library.py --config /etc/filebeans-reencode.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
KillMode=mixed
Nice=10
CPUWeight=10
OOMScoreAdjust=500
UMask=0077

[Install]
WantedBy=multi-user.target
